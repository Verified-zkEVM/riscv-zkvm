open Flapjack Flapjack.Pancake.PanLang Flapjack.Basis.Pure.MlString
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000
set_option Elab.async false

def declarationName : Decl (BitVec 64) → Option MlS
  | .function fn => some (ofString fn.name)
  | _ => none

def declarationNames (declarations : List (Decl (BitVec 64))) : List (Option MlS) :=
  declarations.map declarationName

def functionNames (declarations : List (Decl (BitVec 64))) : List MlS :=
  declarations.filterMap declarationName

