import PancakeDiv256.Source.SourceNames
import PancakeDiv256.Source.U256FallbackClosure

/-! Candidate flattened source call/effect graph, checked against every
actual body including exception handlers. Ranks are checked separately. -/
namespace PancakeDiv256.Source.SourceRanks
open Flapjack Flapjack.Pancake.PanLang Flapjack.Basis.Pure.MlString
open U256FallbackClosure
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000
set_option Elab.async false

def callGraph (declarations : List (Decl (BitVec 64))) : List (MlS × List MlS) :=
  declarations.filterMap (fun | .function fn => some (ofString fn.name,(internalCalls fn.body).map ofString) | _ => none)

def effectGraph (declarations : List (Decl (BitVec 64))) : List (MlS × List MlS) :=
  declarations.filterMap (fun | .function fn => some (ofString fn.name,(externalCalls fn.body).map ofString) | _ => none)

