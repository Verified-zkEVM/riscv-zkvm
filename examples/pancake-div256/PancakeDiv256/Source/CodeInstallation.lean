private theorem updateList_eq_updateListEq (code : Calls.Code)
    (entries : List (MlS × List (MlS × ShapeHOL) × ProgHOL 64 × ShapeHOL)) :
    code.updateList entries = code.updateListEq entries := by
  apply HolFiniteMapExact.ext
  funext name
  simp only [HolFiniteMapExact.lookup_updateList, HolFiniteMapExact.lookup_updateListEq]
  rw [FUPDATE_LIST_HOL_eq_FUPDATE_LIST]

/-- A successful run of the actual declaration evaluator installs this exact
code map. No uniqueness, shape-check, or implementation premise is supplied. -/
theorem evaluateDecls_codeOf (state : SourceState H) [DecidablePred state.memaddrs]
    (declarations : List (Decl (BitVec 64))) (post : SourceState H)
    (empty : state.code = HolFiniteMapExact.empty)
    (evaluated : evaluateDeclsHOLFinite state (declarations.map declToHOL) = some post) :
    post.code = codeOf declarations := by
  have installed := evaluateDeclsHOLFinite_functions state (declarations.map declToHOL) post evaluated
  rw [empty, updateList_eq_updateListEq] at installed
  exact installed

theorem original_of_declarations (state : SourceState H) [DecidablePred state.memaddrs]
    (post : SourceState H) (empty : state.code = HolFiniteMapExact.empty)
    (evaluated : evaluateDeclsHOLFinite state (Guest.Software.guestAst.map declToHOL) = some post) :
    post.code = original := evaluateDecls_codeOf state _ post empty evaluated

theorem hinted_of_declarations (state : SourceState H) [DecidablePred state.memaddrs]
    (post : SourceState H) (empty : state.code = HolFiniteMapExact.empty)
    (evaluated : evaluateDeclsHOLFinite state (hintedGuestAst.map declToHOL) = some post) :
    post.code = hinted := evaluateDecls_codeOf state _ post empty evaluated

theorem original_installed_of_declarations (state : SourceState H) [DecidablePred state.memaddrs]
    (post : SourceState H) (empty : state.code = HolFiniteMapExact.empty)
    (evaluated : evaluateDeclsHOLFinite state (Guest.Software.guestAst.map declToHOL) = some post) :
    Installed post := original_installed post (original_of_declarations state post empty evaluated)

theorem hinted_installed_of_declarations (state : SourceState H) [DecidablePred state.memaddrs]
    (post : SourceState H) (empty : state.code = HolFiniteMapExact.empty)
    (evaluated : evaluateDeclsHOLFinite state (hintedGuestAst.map declToHOL) = some post) :
    Installed post := hinted_installed post (hinted_of_declarations state post empty evaluated)

end PancakeDiv256.Source.CodeInstallation
