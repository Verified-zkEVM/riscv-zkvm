  · exact (congrArg (fun map : Calls.Code => map.lookup (ofString "u256_lt")) code).trans original_lt
  · exact (congrArg (fun map : Calls.Code => map.lookup (ofString "udivmod")) code).trans original_word
  · exact (congrArg (fun map : Calls.Code => map.lookup (ofString "u256_divmod")) code).trans original_divmod
  · exact (congrArg (fun map : Calls.Code => map.lookup (ofString "u256_div")) code).trans original_quotient
