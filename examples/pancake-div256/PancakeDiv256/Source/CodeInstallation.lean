private theorem encoded_names_exact :
    SourceRanks.declarationNameVector.map nameKey = encodedNames := by decide +kernel

private theorem noShadowNames_of_keys (names : List (Option MlS)) (query : MlS)
    (safe : noShadowKeys (names.map nameKey) (InitE.MetadataComputation.nameFingerprint query) = true) :
    noShadowNames names query = true := by
  apply List.all_eq_true.mpr
  intro name member
  cases name with
  | none => rfl
  | some name =>
    apply bne_iff_ne.mpr
    intro equal
    have keyMember : some (InitE.MetadataComputation.nameFingerprint name) ∈ names.map nameKey :=
      List.mem_map.mpr ⟨some name,member,rfl⟩
    have checked := List.all_eq_true.mp safe _ keyMember
    change (InitE.MetadataComputation.nameFingerprint name !=
      InitE.MetadataComputation.nameFingerprint query) = true at checked
    exact (bne_iff_ne.mp checked) (congrArg InitE.MetadataComputation.nameFingerprint equal)

private theorem original_suffix_free_names (offset : Nat) (query : MlS)
    (certificate : noShadowNames (SourceRanks.declarationNameVector.drop offset) query = true) :
    noShadow (Guest.Software.guestAst.drop offset) query = true := by
  rw [noShadow_names]
  have projected := (declarationNames_drop Guest.Software.guestAst offset).trans
    (congrArg (List.drop offset) SourceRanks.declaration_names_exact)
  rw [projected]
  exact certificate

private theorem original_suffix_free (offset : Nat) (query : MlS) (key : Nat)
    (tag : InitE.MetadataComputation.nameFingerprint query = key)
    (certificate : noShadowKeys (encodedNames.drop offset) key = true) :
    noShadow (Guest.Software.guestAst.drop offset) query = true := by
  apply original_suffix_free_names offset query
  apply noShadowNames_of_keys
  have projected : (SourceRanks.declarationNameVector.drop offset).map nameKey =
      encodedNames.drop offset := List.map_drop.trans
        (congrArg (List.drop offset) encoded_names_exact)
  rw [projected,tag]
  exact certificate

private theorem noShadow_append (first second : List (Decl (BitVec 64))) (query : MlS) :
    noShadow (first ++ second) query = (noShadow first query && noShadow second query) := by
  simp only [noShadow,List.all_append]

private theorem noShadow_overlay (declarations : List (Decl (BitVec 64))) (query : MlS) :
    noShadow (declarations.map (replaceDivOpcode "hinted_u256_div")) query =
      noShadow declarations query := by
  induction declarations with
  | nil => rfl
  | cons declaration rest ih =>
    cases declaration with
    | function fn =>
      by_cases changed : fn.name = "op_div"
      · simp only [List.map_cons,replaceDivOpcode,changed,ite_true,noShadow,List.all_cons]
        simp only [divOpcodeWith,withBody,Guest.Software.guestFn_op_div]
        exact congrArg (fun tail => (ofString "op_div" != query) && tail) ih
      · simp only [List.map_cons,replaceDivOpcode,changed,ite_false,noShadow,List.all_cons]
        exact congrArg (fun tail => (ofString fn.name != query) && tail) ih
    | decl shape name value =>
      simpa only [List.map_cons,replaceDivOpcode,noShadow,List.all_cons,Bool.true_and] using ih
    | exnDecl name shape =>
      simpa only [List.map_cons,replaceDivOpcode,noShadow,List.all_cons,Bool.true_and] using ih
    | name name fields =>
      simpa only [List.map_cons,replaceDivOpcode,noShadow,List.all_cons,Bool.true_and] using ih

