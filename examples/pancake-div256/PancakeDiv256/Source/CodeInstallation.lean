/-! Concrete semantic code maps from the exact original and optional source
ASTs. These are the code fields installed by source declaration evaluation;
no helper implementation is supplied as a correctness parameter. -/

namespace PancakeDiv256.Source.CodeInstallation

open Flapjack Flapjack.Pancake.PanLang Flapjack.Basis.Pure.MlString
open PanSemStateFiniteExact LoopSemantics HintValidation

set_option maxRecDepth 100000
set_option maxHeartbeats 1000000
set_option Elab.async false


private theorem functions_append (first second : List (DeclHOL 64)) :
    functionsHOL (first ++ second) = functionsHOL first ++ functionsHOL second := by
  induction first with
  | nil => rfl
  | cons head rest ih =>
    cases head <;> simp only [List.cons_append,functionsHOL,ih]

private theorem update_append (initial : MlS → Option (List (MlS × ShapeHOL) × ProgHOL 64 × ShapeHOL))
    (first second : List (MlS × List (MlS × ShapeHOL) × ProgHOL 64 × ShapeHOL)) :
    FUPDATE_LIST_HOL initial (first ++ second) = FUPDATE_LIST_HOL (FUPDATE_LIST_HOL initial first) second := by
  induction first generalizing initial with
  | nil => rfl
  | cons entry rest ih => rw [List.cons_append,FUPDATE_LIST_HOL_cons,ih,FUPDATE_LIST_HOL_cons]

private theorem update_unshadowed (initial : MlS → Option (List (MlS × ShapeHOL) × ProgHOL 64 × ShapeHOL))
    (entries : List (MlS × List (MlS × ShapeHOL) × ProgHOL 64 × ShapeHOL)) (name : MlS)
    (none : entries.all (fun entry => entry.1 != name) = true) :
    FUPDATE_LIST_HOL initial entries name = initial name := by
  induction entries generalizing initial with
  | nil => rfl
  | cons entry rest ih =>
    simp only [List.all_cons,Bool.and_eq_true,bne_iff_ne] at none
    rw [FUPDATE_LIST_HOL_cons,ih _ none.2]
    simp only [FUPDATE_HOL,Ne.symm none.1,ite_false]

private def functionOf : Decl (BitVec 64) → FunDecl (BitVec 64)
  | .function fn => fn
  | _ => ⟨"",false,false,[],.skip,.one⟩

private def noShadow (declarations : List (Decl (BitVec 64))) (query : MlS) : Bool :=
  declarations.all (fun | .function fn => ofString fn.name != query | _ => true)

private theorem noShadow_entries (declarations : List (Decl (BitVec 64))) (query : MlS)
    (safe : noShadow declarations query = true) :
    (functionsHOL (declarations.map declToHOL)).all (fun entry => entry.1 != query) = true := by
  induction declarations with
  | nil => rfl
  | cons declaration rest ih =>
    cases declaration <;>
      simp only [noShadow,List.all_cons,Bool.and_eq_true] at safe
    all_goals
      simp only [List.map_cons,declToHOL,functionsHOL,List.all_cons,funDeclToHOL,Bool.and_eq_true]
    · exact ⟨safe.1,ih safe.2⟩
    all_goals exact ih safe.2

private theorem install_at (before after : List (Decl (BitVec 64))) (fn : FunDecl (BitVec 64))
    (unshadowed : noShadow after (ofString fn.name) = true) :
    (codeOf (before ++ .function fn :: after)).lookup (ofString fn.name) =
      some ((funDeclToHOL fn).params,(funDeclToHOL fn).body,(funDeclToHOL fn).returnShape) := by
  simp only [codeOf,HolFiniteMapExact.lookup_updateListEq,List.map_append,functions_append,update_append]
  simp only [List.map_cons,declToHOL,functionsHOL,FUPDATE_LIST_HOL_cons]
  rw [update_unshadowed _ _ _ (noShadow_entries after _ unshadowed)]
  simp only [funDeclToHOL,FUPDATE_HOL,ite_true]

/-- Structural cut: only the selected list cell is reduced in concrete proofs. -/
private theorem cut_at (declarations : List (Decl (BitVec 64))) (index : Nat)
    (declaration : Decl (BitVec 64)) (selected : declarations[index]? = some declaration) :
    declarations = declarations.take index ++ declaration :: declarations.drop (index+1) := by
  induction index generalizing declarations with
  | zero =>
    cases declarations with
    | nil => simp at selected
    | cons head rest =>
      have same : head = declaration := Option.some.inj selected
      cases same
      rfl
  | succ index ih =>
    cases declarations with
    | nil => simp at selected
    | cons head rest =>
      have tail : rest[index]? = some declaration := selected
      change head :: rest = head :: (rest.take index ++ declaration :: rest.drop (index+1))
      exact congrArg (List.cons head) (ih rest tail)

/-- All code-map congruence is proved while the declaration list is abstract;
concrete applications never normalize unrelated translated function bodies. -/
private theorem install_cut (declarations before after : List (Decl (BitVec 64)))
    (declaration : Decl (BitVec 64)) (fn : FunDecl (BitVec 64))
    (name : MlS) (parameters : List (MlS × ShapeHOL)) (body : ProgHOL 64) (shape : ShapeHOL)
    (cut : declarations = before ++ declaration :: after)
    (function : declaration = .function fn)
    (unshadowed : noShadow after name = true)
    (sameName : ofString fn.name = name)
    (sameParameters : (funDeclToHOL fn).params = parameters)
    (sameBody : (funDeclToHOL fn).body = body)
    (sameShape : (funDeclToHOL fn).returnShape = shape) :
    (codeOf declarations).lookup name = some (parameters,body,shape) := by
  cases cut
  cases function
  cases sameName
  cases sameParameters
  cases sameBody
  cases sameShape
  exact install_at before after fn unshadowed

private theorem overlay_cut (declarations before after : List (Decl (BitVec 64)))
    (declaration : Decl (BitVec 64)) (cut : declarations = before ++ declaration :: after) :
    declarations.map (replaceDivOpcode "hinted_u256_div") ++ [hintedHelper] =
      before.map (replaceDivOpcode "hinted_u256_div") ++
      replaceDivOpcode "hinted_u256_div" declaration ::
        (after.map (replaceDivOpcode "hinted_u256_div") ++ [hintedHelper]) := by
  rw [cut,List.map_append,List.map_cons,List.append_assoc,List.cons_append]

private theorem lookup_absent (declarations : List (Decl (BitVec 64))) (name : MlS)
    (absent : noShadow declarations name = true) : (codeOf declarations).lookup name = none := by
  unfold codeOf
  simp only [HolFiniteMapExact.lookup_updateListEq]
  rw [update_unshadowed _ _ _ (noShadow_entries _ _ absent)]
  rfl

private def noShadowNames (names : List (Option MlS)) (query : MlS) : Bool :=
  names.all (fun name => name.all (fun actual => actual != query))

private theorem noShadow_names (declarations : List (Decl (BitVec 64))) (query : MlS) :
    noShadow declarations query = noShadowNames (SourceRanks.declarationNames declarations) query := by
  induction declarations with
  | nil => rfl
  | cons declaration rest ih =>
    cases declaration <;>
      simp_all [noShadow,noShadowNames,SourceRanks.declarationNames,SourceRanks.declarationName]

private theorem declarationNames_drop (declarations : List (Decl (BitVec 64))) (offset : Nat) :
    SourceRanks.declarationNames (declarations.drop offset) =
      (SourceRanks.declarationNames declarations).drop offset := by
  exact List.map_drop

private def nameKey (name : Option MlS) : Option Nat :=
  name.map InitE.MetadataComputation.nameFingerprint
private def noShadowKeys (keys : List (Option Nat)) (query : Nat) : Bool :=
  keys.all (fun key => key.all (fun actual => actual != query))

