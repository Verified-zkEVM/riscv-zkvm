open Stages
set_option Elab.async false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

/-- The native proposal is checked against only the actual changed main. -/
theorem simplified_main_eq : HeaderSimplification.simplifiedMain = Data.simplified0 := by
  unfold HeaderSimplification.simplifiedMain HeaderOrdering.main
  rw [←Deployment.HeaderSyntax.codec_prefix]
  change InitECandidate.Proofs.FrontendComputation.simplifyDeclaration
    (declToHOL (Deployment.HeaderSyntax.prefixBody Guest.Software.guestFn_main)) = declToHOL Data.simplified0Data
  simp only [InitECandidate.Proofs.FrontendCodecComputation.declToHOL_eq]
  kernel_rfl

theorem simplified_div_eq : simplifyOne replacement = Data.simplified479 := by
  change InitECandidate.Proofs.FrontendComputation.simplifyDeclaration
    (declToHOL (Source.divOpcodeWith "hinted_u256_div")) = declToHOL Data.simplified479Data
  simp only [InitECandidate.Proofs.FrontendCodecComputation.declToHOL_eq]
  kernel_rfl

theorem simplified_helper_eq : simplifyOne helper = Data.simplified890 := by
  change InitECandidate.Proofs.FrontendComputation.simplifyDeclaration
    (declToHOL Source.hintedHelper) = declToHOL Data.simplified890Data
  simp only [InitECandidate.Proofs.FrontendCodecComputation.declToHOL_eq]
  kernel_rfl

def rewriteLiteral : DeclHOL 64 → DeclHOL 64
  | .function fn => if fn.name = Basis.Pure.MlString.ofString "op_div" then Data.simplified479 else .function fn
  | declaration => declaration

theorem rewrite_literal_eq : rewriteSimplified = rewriteLiteral := by
  funext declaration
  cases declaration with
  | function fn =>
    by_cases selected : fn.name = Basis.Pure.MlString.ofString "op_div"
    · simpa only [rewriteSimplified,rewriteLiteral,selected,ite_true] using simplified_div_eq
    · simp only [rewriteSimplified,rewriteLiteral,selected,ite_false]
  | decl => rfl
  | exnDecl => rfl
  | name => rfl

