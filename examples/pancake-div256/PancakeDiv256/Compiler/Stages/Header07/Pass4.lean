private theorem reuse {input : Nat × MlString × List Nat × CrepProgHOL 64}
    {output : Nat × List Nat × HolLoopProg 64}
    (avoids : FrontendWeakeningLoop.noCallee CrepContext.fresh input.2.2.2 = true)
    (original : InitECandidate.Proofs.LoopComputation.compileEntry
      Compiler.Encoders.RiscV.Target.riscvConfig.isa
      InitECandidate.Proofs.FrontendStages.Loop.functionMap input = output) :
    InitECandidate.Proofs.LoopComputation.compileEntry Compiler.Encoders.RiscV.Target.riscvConfig.isa
      LoopContext.functionMap input = output := by
  rw [← LoopFrames.compileEntry_noCallee CrepContext.fresh _ _ _ _ LoopContext.agrees avoids]
  exact original

