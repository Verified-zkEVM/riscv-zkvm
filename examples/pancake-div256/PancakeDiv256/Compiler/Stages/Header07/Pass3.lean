private theorem reuse {declaration : DeclHOL 64}
    {output : MlS × List Nat × CrepProgHOL 64}
    (avoids : CrepFrames.noCalleeDeclaration CrepContext.fresh declaration = true)
    (original : InitECandidate.Proofs.CrepComputation.compileDeclaration
      InitECandidate.Proofs.FrontendStages.Crep.functionMap CrepContext.exceptionMap declaration = some output) :
    InitECandidate.Proofs.CrepComputation.compileDeclaration
      CrepContext.functionMap CrepContext.exceptionMap declaration = some output := by
  rw [← CrepFrames.compileDeclaration_noCallee CrepContext.fresh _ _ _ _ CrepContext.agrees avoids]
  exact original

