import Flapjack.Pancake.WordLang
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option Elab.async false
/-! Concrete allocated input proposal; frontend equality is checked separately. -/
namespace PancakeDiv256.Compiler.BackendInput
open Flapjack
def allocatedBody100_0 : WordLangProgHOL (BitVec 64) :=
Flapjack.WordLangProgHOL.move 1 (List.cons { fst := 2, snd := 2 } (List.cons { fst := 0, snd := 0 } List.nil))

def allocatedBody100_1 : WordLangProgHOL (BitVec 64) :=
Flapjack.WordLangProgHOL.return 0 (List.cons 2 List.nil)

def allocatedBody100_2 : WordLangProgHOL (BitVec 64) :=
.seq allocatedBody100_0 allocatedBody100_1

def allocated100 : Nat × Nat × WordLangProgHOL (BitVec 64) := (100,5,allocatedBody100_2)
end PancakeDiv256.Compiler.BackendInput
