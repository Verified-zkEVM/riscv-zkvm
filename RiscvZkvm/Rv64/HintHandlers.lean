/- Stateful transport adapters. Transcripts belong to the external handler,
   never to the suspended guest or the bounded Control state. -/
module
public import RiscvZkvm.Rv64.ResumableHints
@[expose] public section
namespace RiscvZkvm.Rv64.ResumableHints

/-- Erasing instrumentation must commute with each response and host update. -/
def HandlerProjection {H K Q : Type} {R : Q → Type}
    (source : Handler H Q R) (target : Handler K Q R) (project : K → H) : Prop :=
  ∀ q k, project (target q k).1 = (source q (project k)).1 ∧
    (target q k).2 = (source q (project k)).2

 theorem drive_projection {S Q A H K : Type} {R : Q → Type}
    (tick : S → Event S Q A) (accept : (q : Q) → S → R q → S)
    (source : Handler H Q R) (target : Handler K Q R) (project : K → H)
    (sim : HandlerProjection source target project) (fuel : Nat)
    (c : Control S Q A) (k : K) :
    ((drive tick accept target fuel c k).1,
      project (drive tick accept target fuel c k).2) =
    drive tick accept source fuel c (project k) := by
  cases c with
  | waiting q s => simp only [drive, resume, (sim q k).1, (sim q k).2]
  | running s | exhausted s | returned a | trap => rfl

 theorem execute_projection {S Q A H K : Type} {R : Q → Type}
    (tick : S → Event S Q A) (accept : (q : Q) → S → R q → S)
    (source : Handler H Q R) (target : Handler K Q R) (project : K → H)
    (sim : HandlerProjection source target project) (fuel n : Nat)
    (state : Control S Q A × K) :
    ((execute tick accept target fuel n state).1,
      project (execute tick accept target fuel n state).2) =
    execute tick accept source fuel n (state.1, project state.2) := by
  induction n generalizing state with
  | zero => rfl
  | succ n ih =>
    simp only [execute]
    rw [ih, drive_projection tick accept source target project sim]

/-- Typed transcripts record the exact question with each untrusted answer. -/
abbrev Transcript (Q : Type) (R : Q → Type) := List ((q : Q) × R q)

def recording {H Q : Type} {R : Q → Type} (source : Handler H Q R) :
    Handler (H × Transcript Q R) Q R := fun q state =>
  let answer := source q state.1
  ((answer.1, state.2 ++ [⟨q, answer.2⟩]), answer.2)

 theorem recording_projection {H Q : Type} {R : Q → Type} (source : Handler H Q R) :
    HandlerProjection source (recording source) Prod.fst := by
  intro q state
  exact ⟨rfl, rfl⟩

/-- Instrumentation preserves the entire guest control, including errors,
    pending questions and exhaustion, for any finite observation horizon. -/
 theorem recording_preserves_execution {S Q A H : Type} {R : Q → Type}
    (tick : S → Event S Q A) (accept : (q : Q) → S → R q → S)
    (source : Handler H Q R) (fuel n : Nat) (c : Control S Q A) (h : H)
    (trace : Transcript Q R) :
    (execute tick accept (recording source) fuel n (c, (h, trace))).1 =
    (execute tick accept source fuel n (c, h)).1 :=
  congrArg Prod.fst (execute_projection tick accept source (recording source)
    Prod.fst (recording_projection source) fuel n (c, (h, trace)))

inductive ReplayError where
  | missing
  | mismatched
  deriving DecidableEq, Repr

/-- A matching entry is consumed once. Missing/mismatched entries cause an
    explicit transport error and retain the tape, so retry behavior is defined. -/
def replay {Q : Type} {R : Q → Type} [DecidableEq Q] (q : Q) :
    Transcript Q R → Transcript Q R × Except ReplayError (R q)
  | [] => ([], .error .missing)
  | ⟨q', r⟩ :: rest =>
    if h : q' = q then (rest, .ok (h ▸ r))
    else (⟨q', r⟩ :: rest, .error .mismatched)

@[simp] theorem replay_match {Q : Type} {R : Q → Type} [DecidableEq Q]
    (q : Q) (r : R q) (rest : Transcript Q R) :
    replay q (⟨q,r⟩ :: rest) = (rest, .ok r) := by simp [replay]

 theorem replay_mismatch {Q : Type} {R : Q → Type} [DecidableEq Q]
    (q q' : Q) (r : R q') (rest : Transcript Q R) (h : q' ≠ q) :
    replay q (⟨q',r⟩ :: rest) = (⟨q',r⟩ :: rest, .error .mismatched) := by
  simp [replay, h]

@[simp] theorem replay_missing {Q : Type} {R : Q → Type} [DecidableEq Q] (q : Q) :
    replay (R := R) q [] = ([], .error .missing) := rfl

/-- Raw channels can map transport errors to a malformed response. The concrete
    modinv channel uses [] so the guest deterministically traps on an error. -/
def replayOr {Q : Type} {R : Q → Type} [DecidableEq Q]
    (fallback : (q : Q) → R q) : Handler (Transcript Q R) Q R := fun q tape =>
  let result := replay q tape
  (result.1, match result.2 with | .ok r => r | .error _ => fallback q)

/-- The finite external transcript generated by the authoritative scheduler.
    It records exactly those questions that the actual execution asks, including
    repetitions and questions depending on previous replies. -/
def generatedTranscript {S Q A H : Type} {R : Q → Type}
    (tick : S → Event S Q A) (accept : (q : Q) → S → R q → S)
    (source : Handler H Q R) (fuel : Nat) :
    Nat → Control S Q A × H → Transcript Q R
  | 0, _ => []
  | n + 1, state =>
    let rest := generatedTranscript tick accept source fuel n
      (drive tick accept source fuel state.1 state.2)
    match state.1 with
    | .waiting q _ => ⟨q, (source q state.2).2⟩ :: rest
    | _ => rest

/-- Replaying the generated transcript reproduces *exactly* the guest control,
    and consumes exactly that transcript, leaving an arbitrary suffix alone.
    This covers pending/exhausted/trapped/returned controls, not just success. -/
 theorem generated_replay_preserves {S Q A H : Type} {R : Q → Type} [DecidableEq Q]
    (tick : S → Event S Q A) (accept : (q : Q) → S → R q → S)
    (source : Handler H Q R) (fallback : (q : Q) → R q) (fuel n : Nat)
    (c : Control S Q A) (h : H) (tail : Transcript Q R) :
    execute tick accept (replayOr fallback) fuel n
      (c, generatedTranscript tick accept source fuel n (c,h) ++ tail) =
    ((execute tick accept source fuel n (c,h)).1, tail) := by
  induction n generalizing c h with
  | zero => rfl
  | succ n ih =>
    cases c with
    | waiting q s =>
      simpa only [generatedTranscript, execute, drive, List.cons_append,
        replayOr, replay_match, resume] using
        ih (.running (accept q s (source q h).2)) (source q h).1
    | running s =>
      simpa only [generatedTranscript, execute, drive] using ih (run tick fuel s) h
    | exhausted s =>
      simpa only [generatedTranscript, execute, drive] using ih (run tick fuel s) h
    | returned a =>
      simpa only [generatedTranscript, execute, drive] using ih (.returned a) h
    | trap =>
      simpa only [generatedTranscript, execute, drive] using ih .trap h

/-- Recording's accumulated list is precisely the transcript used by the
    replay refinement, even when recording starts with an existing prefix. -/
 theorem recording_transcript {S Q A H : Type} {R : Q → Type}
    (tick : S → Event S Q A) (accept : (q : Q) → S → R q → S)
    (source : Handler H Q R) (fuel n : Nat) (c : Control S Q A) (h : H)
    (prior : Transcript Q R) :
    (execute tick accept (recording source) fuel n (c,(h,prior))).2.2 =
      prior ++ generatedTranscript tick accept source fuel n (c,h) := by
  induction n generalizing c h prior with
  | zero => simp [execute, generatedTranscript]
  | succ n ih =>
    cases c with
    | waiting q s =>
      simp only [execute, drive, recording, resume, generatedTranscript]
      exact (ih (.running (accept q s (source q h).2)) (source q h).1
        (prior ++ [⟨q,(source q h).2⟩])).trans
        (List.append_assoc prior [⟨q,(source q h).2⟩] _)
    | running s =>
      simpa only [execute, drive, generatedTranscript] using ih (run tick fuel s) h prior
    | exhausted s =>
      simpa only [execute, drive, generatedTranscript] using ih (run tick fuel s) h prior
    | returned a =>
      simpa only [execute, drive, generatedTranscript] using ih (.returned a) h prior
    | trap =>
      simpa only [execute, drive, generatedTranscript] using ih .trap h prior

/-- Directly replay the output of the stateful recording adapter. -/
 theorem recorded_replay_preserves {S Q A H : Type} {R : Q → Type} [DecidableEq Q]
    (tick : S → Event S Q A) (accept : (q : Q) → S → R q → S)
    (source : Handler H Q R) (fallback : (q : Q) → R q) (fuel n : Nat)
    (c : Control S Q A) (h : H) :
    execute tick accept (replayOr fallback) fuel n
      (c,(execute tick accept (recording source) fuel n (c,(h,[]))).2.2) =
      ((execute tick accept source fuel n (c,h)).1, []) := by
  rw [recording_transcript]
  simpa using generated_replay_preserves tick accept source fallback fuel n c h []

end RiscvZkvm.Rv64.ResumableHints
